{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "category_uid": {
      "enum": [
        0,
        6
      ]
    },
    "class_uid": {
      "enum": [
        0,
        6003
      ]
    },
    "activity_id": {
      "enum": [
        1,
        2,
        3,
        4,
        99
      ]
    },
    "type_uid": {
      "type": "integer",
      "minimum": 0
    },
    "severity_id": {
      "const": 0
    },
    "time": {
      "type": "integer",
      "minimum": 0
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "1.6.0"
        },
        "uid": {
          "type": "string",
          "minLength": 1
        },
        "product": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "vendor_name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name",
            "vendor_name",
            "version"
          ]
        },
        "correlation_uid": {
          "type": "string",
          "minLength": 1
        },
        "original_time": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "version",
        "uid",
        "product",
        "correlation_uid",
        "original_time"
      ]
    },
    "unmapped": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ai_forensic_readiness": {
          "type": "object"
        },
        "mapping_notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "ai_forensic_readiness",
        "mapping_notes"
      ]
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "uid": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "uid"
          ]
        }
      },
      "required": [
        "user"
      ]
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "operation"
      ]
    },
    "src_endpoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "uid"
      ]
    },
    "status_id": {
      "enum": [
        0,
        1,
        2
      ]
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "uid": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "uid"
        ]
      }
    }
  },
  "required": [
    "category_uid",
    "class_uid",
    "activity_id",
    "type_uid",
    "severity_id",
    "time",
    "message",
    "metadata",
    "unmapped"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "class_uid": {
            "const": 6003
          }
        }
      },
      "then": {
        "required": [
          "actor",
          "api",
          "src_endpoint",
          "status_id"
        ],
        "properties": {
          "category_uid": {
            "const": 6
          }
        }
      },
      "else": {
        "properties": {
          "category_uid": {
            "const": 0
          },
          "activity_id": {
            "const": 99
          },
          "type_uid": {
            "const": 99
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ocsf-projection local reference shape; not upstream conformance certification",
  "$id": "https://raw.githubusercontent.com/Scoston/ai-forensic-readiness/main/mappings/ocsf-projection.schema.json"
}
